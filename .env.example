ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=file:./wheel-of-time.db

# Voyage AI — used for ref-doc embeddings (voyage-law-2) and reranking
# (rerank-2.5). Required for `npm run refdocs:ingest` and for ref-doc search
# to use semantic + reranked retrieval. Without it, the system falls back to
# FTS-only retrieval.
VOYAGE_API_KEY=pa-...

# Shared passcode for the demo frontend. Anyone with this string can use the
# app — set it to something not-easily-guessable. Required when running the
# web UI locally; the /api/auth/login route 500s if unset.
DEMO_PASSCODE=
