ANTHROPIC_API_KEY=sk-ant-...

# Supabase Postgres connection string — Mastra's runtime tables (threads,
# messages, traces, working memory) live here under the `mastra` schema.
# Get it from Supabase Dashboard → Project Settings → Database → Connection
# string. For Render (long-running Node) use the "Session pooler" (port 5432);
# for serverless deploys later use "Transaction pooler" (port 6543).
POSTGRES_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Legacy libsql DB — temporarily holds the not-yet-migrated domain tables
# (tax_facts, open_questions, ai_decisions). Goes away when those move to
# Supabase. MUST be an absolute path: `mastra dev` launches with
# cwd=apps/agent/src/mastra/public, so a relative path silently resolves to
# different files depending on context (dev server vs. shell scripts).
DATABASE_URL=file:/absolute/path/to/wheel-of-time.db

# Voyage AI — used for ref-doc embeddings (voyage-law-2) and reranking
# (rerank-2.5). Required for `npm run refdocs:ingest` and for ref-doc search
# to use semantic + reranked retrieval. Without it, the system falls back to
# FTS-only retrieval.
VOYAGE_API_KEY=pa-...

# Shared passcode for the demo frontend. Anyone with this string can use the
# app — set it to something not-easily-guessable. Required when running the
# web UI locally; the /api/auth/login route 500s if unset.
DEMO_PASSCODE=

# Comma-separated list of origins allowed to call the API cross-origin.
# Required in prod once the frontend deploys to Vercel separately. Supports a
# leading "*." wildcard for preview-deploy domains. Empty / unset = allow any
# origin (intended for local dev only).
# Example: ALLOWED_ORIGINS=https://wheel-of-time-web.vercel.app,https://*.vercel.app
ALLOWED_ORIGINS=
