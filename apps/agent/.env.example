# ── Required ────────────────────────────────────────────────────────────────

# Anthropic — powers Luca (Sonnet) and the grounding/contextualization passes
# (Haiku). The one key the app cannot run without.
ANTHROPIC_API_KEY=sk-ant-...

# ── Models (REQUIRED — no in-code defaults; startup fails without these) ────
# Two model roles, each a "provider/model" string resolved through Mastra's
# provider registry (cloud, keyed by the provider's *_API_KEY above).
LUCA_MODEL=anthropic/claude-sonnet-4-6    # conversation + document reading (needs vision)
JUDGE_MODEL=anthropic/claude-haiku-5-5    # grounding judges (needs structured output)

# To run a role against a local or self-hosted OpenAI-compatible server
# (Ollama, vLLM, LM Studio, llama.cpp, Hugging Face endpoint), set its URL —
# the model string then names the model on that server:
# LUCA_MODEL=ollama/qwen3-vl:8b
# LUCA_MODEL_URL=http://localhost:11434/v1
# LUCA_MODEL_API_KEY=                       # only if the server requires one

# ── Optional ────────────────────────────────────────────────────────────────

# Local embedding model for reference-doc retrieval (RAG). Runs via Ollama
# (install from https://ollama.com, then `ollama pull embeddinggemma-2`).
# Without Ollama running, search gracefully degrades to FTS5 keyword-only.
# Defaults shown; uncomment to override.
# EMBEDDINGS_MODEL=ollama/embeddinggemma-2
# EMBEDDINGS_MODEL_URL=http://localhost:11434

# Contextual-summary model for corpus ingest (corpus sync). Defaults to
# Haiku (claude-haiku-5-5, ~$0.50/doc — the contributor path).
# The official published corpus is built with claude-opus-5 ($17.35
# measured for the full 10-doc rebuild; maintainer pays once).
# REFDOCS_MODEL=claude-opus-5

# Shared-token gate for /api/* and /app/* — set this when the agent port is
# reachable beyond localhost (the web app's proxy attaches it server-side).
# Unset = open, which is fine when the agent binds to 127.0.0.1.
# AGENT_API_TOKEN=

# ── Local data files (SQLite + blobs) ───────────────────────────────────────
# Everything persistent lives under .data/. Absolute paths recommended — the
# module-relative defaults resolve differently inside Mastra's bundled output
# than in tsx scripts, so pinning them here keeps every entry point on the
# same files.
CORPUS_DB_PATH=/absolute/path/to/apps/agent/.data/corpus.db
APP_DB_PATH=/absolute/path/to/apps/agent/.data/app.db
MASTRA_DB_PATH=/absolute/path/to/apps/agent/.data/mastra.db
DOCUMENTS_PATH=/absolute/path/to/apps/agent/.data/documents

# ── Dev knobs ───────────────────────────────────────────────────────────────

# Set to "true" locally to enable verbose tracing (dumps full agent I/O
# including base64 uploads to stdout). Leave unset or "false" in production.
# `mastra dev` sets this automatically.
MASTRA_DEV=true
