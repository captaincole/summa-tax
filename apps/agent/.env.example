# ── Required ────────────────────────────────────────────────────────────────

# Anthropic — powers Luca (Sonnet) and the grounding/contextualization passes
# (Haiku). The one key the app cannot run without.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase AUTH (the only Supabase piece left — goes away in Phase 2 of the
# open-source transition). Local dev: `npm run db:start` boots the stack and
# `npm run db:status` prints these values. URL is the API gateway.
SUPABASE_URL=http://127.0.0.1:54321
# Publishable key — used by MastraAuthSupabase to verify JWTs sent by the
# frontend after signInWithPassword. Public/safe-to-expose.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret (service-role) key — used only for GoTrue admin calls (seeding test
# users, verifying invitees exist). Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Optional ────────────────────────────────────────────────────────────────

# Voyage AI — embeddings (voyage-law-2) + reranking (rerank-2.5) for
# reference-doc retrieval. Without it, search gracefully degrades to
# FTS5 keyword-only. Required only to (re)build the corpus (refdocs:sync).
VOYAGE_API_KEY=pa-...

# ── Local data files (SQLite + blobs) ───────────────────────────────────────
# Everything persistent lives under .data/. Absolute paths recommended — the
# module-relative defaults resolve differently inside Mastra's bundled output
# than in tsx scripts, so pinning them here keeps every entry point on the
# same files.
CORPUS_DB_PATH=/absolute/path/to/apps/agent/.data/corpus.db
APP_DB_PATH=/absolute/path/to/apps/agent/.data/app.db
MASTRA_DB_PATH=/absolute/path/to/apps/agent/.data/mastra.db
DOCUMENTS_PATH=/absolute/path/to/apps/agent/.data/documents

# ── Server/dev knobs ────────────────────────────────────────────────────────

# Comma-separated list of origins allowed to call the API cross-origin.
# Empty / unset = allow any origin (intended for local dev only).
# Example: ALLOWED_ORIGINS=https://summa-web.example.com
ALLOWED_ORIGINS=

# Set to "true" locally to enable verbose tracing (dumps full agent I/O
# including base64 uploads to stdout). Leave unset or "false" in production.
# `mastra dev` sets this automatically.
MASTRA_DEV=true

# Comma-separated list of emails permitted to sign in to Mastra Studio's
# login screen. Web-app users bypass this list — it only controls direct
# Studio access. Leave unset to disable Studio sign-in entirely.
STUDIO_ALLOWED_EMAILS=you@example.com
