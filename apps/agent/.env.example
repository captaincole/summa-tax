ANTHROPIC_API_KEY=sk-ant-...

# Supabase Postgres connection string — Mastra's runtime tables (threads,
# messages, traces, working memory) live here under the `mastra` schema.
# Get it from Supabase Dashboard → Project Settings → Database → Connection
# string. Use the "Transaction pooler" (port 6543) — it works for local dev,
# Render, and Vercel without changes. Session pooler (port 5432) trips the
# free-tier 15-connection cap when Mastra hot-reloads its 17 storage domains
# in parallel and isn't required for our query patterns.
POSTGRES_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Voyage AI — used for ref-doc embeddings (voyage-law-2) and reranking
# (rerank-2.5). Required for `npm run refdocs:ingest` and for ref-doc search
# to use semantic + reranked retrieval. Without it, the system falls back to
# FTS-only retrieval.
VOYAGE_API_KEY=pa-...

# Supabase publishable key — used by MastraAuthSupabase to verify JWTs sent
# by the frontend after signInWithPassword. Public/safe-to-expose. Different
# from SUPABASE_SECRET_KEY (service role, used for the corpus). Get it from
# Supabase Dashboard → Project Settings → API → "Project API keys" →
# publishable. (On older Supabase projects this is labeled "anon public" and
# is JWT-shaped — same role.)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Comma-separated list of origins allowed to call the API cross-origin.
# Required in prod once the frontend deploys to Vercel separately. Supports a
# leading "*." wildcard for preview-deploy domains. Empty / unset = allow any
# origin (intended for local dev only).
# Example: ALLOWED_ORIGINS=https://wheel-of-time-web.vercel.app,https://*.vercel.app
ALLOWED_ORIGINS=

# Set to "true" locally to enable verbose tracing (dumps full agent I/O
# including base64 uploads to stdout). Leave unset or set to "false" in
# production. `mastra dev` sets this automatically; you only need it here
# when running the built output locally.
MASTRA_DEV=true

# Comma-separated list of emails permitted to sign in to Mastra Studio's
# email/password login screen. Web-app users (web → agent JWT calls) bypass
# this list — it only controls direct Studio access. Set this to your own
# Supabase email; leave unset to disable Studio sign-in entirely.
STUDIO_ALLOWED_EMAILS=you@example.com
