# LOCAL Supabase config template for the agent.
#
# Setup:
#   1. `npm run db:start` (boots local Supabase in Docker)
#   2. `npm run db:status` — copy the API URL, DB URL, anon key, service role key
#   3. Copy this file to .env.development and paste those values in
#
# The keys local Supabase emits are deterministic per JWT secret in
# supabase/config.toml — they're the same across every machine running
# stock Supabase CLI, so what `db:status` prints today will match what it
# prints tomorrow.

# You still need a real Anthropic key for Thom + Nynaeve. Same as prod.
ANTHROPIC_API_KEY=sk-ant-...

# Direct connection to local Postgres (no pooler — db.pooler.enabled = false
# in config.toml). Locally, max_connections is 100, so Mastra's 17-domain
# parallel init doesn't trip the cap.
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Voyage is only needed for refdocs:* commands and for ref-doc search to use
# semantic retrieval. Leave empty for local dev unless you're working on
# the corpus pipeline.
VOYAGE_API_KEY=

# Local Supabase URL. The default API gateway listens on :54321.
SUPABASE_URL=http://127.0.0.1:54321

# Local anon (publishable) key from `supabase status` output.
SUPABASE_PUBLISHABLE_KEY=

# Local service-role key from `supabase status` output. Used for ref-corpus
# admin operations + the seedLocal.ts script. Same powers as the prod
# service-role; safe locally but never paste this anywhere shared.
SUPABASE_SECRET_KEY=

# Empty in local dev = allow any origin (i.e. localhost:3000 from the web
# app calling the agent on localhost:4111).
ALLOWED_ORIGINS=

# Verbose tracing while running locally.
MASTRA_DEV=true

# Mastra Studio sign-in allowlist — set to the email you use to sign in.
STUDIO_ALLOWED_EMAILS=you@example.com
