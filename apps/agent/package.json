{
  "name": "wheel-of-time-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Mastra-based AI CPA backend. Conversational agent (Thom Merrilin) orchestrates fact-gathering and form generation; Nynaeve reviews every AI decision against the IRS reference corpus.",
  "scripts": {
    "dev": "mastra dev --env .env.development",
    "build": "mastra build --studio",
    "start": "cd .mastra/output && node index.mjs",
    "fixtures:build": "tsx fixtures/pipeline/render.ts",
    "db:reset": "tsx scripts/resetUserData.ts",
    "refdocs:ingest": "tsx scripts/ingestRefDoc.ts",
    "refdocs:status": "tsx scripts/refdocsStatus.ts",
    "refdocs:sync": "tsx scripts/refdocsSync.ts",
    "refdocs:verify": "tsx scripts/verifyRefDocs.ts",
    "smoke:review": "tsx scripts/smokeReview.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@libsql/client": "^0.15.15",
    "@mastra/core": "^1.30.0",
    "@mastra/libsql": "^1.9.0",
    "@mastra/loggers": "^1.1.1",
    "@mastra/memory": "^1.17.4",
    "@mastra/observability": "^1.10.3",
    "@supabase/supabase-js": "^2.105.1",
    "dotenv": "^17.4.2",
    "mastra": "^1.7.2",
    "tsx": "^4.20.5",
    "unpdf": "^1.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "pdf-lib": "^1.17.1",
    "typescript": "^5"
  }
}
