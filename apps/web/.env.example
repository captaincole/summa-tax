# Origin of the Mastra API. Used at build time — apps/web/src/lib/apiBase.ts
# reads import.meta.env.VITE_API_URL and prefixes every fetch and <a href>
# that points at the backend.
#
# Local dev: leave unset. Vite's proxy (apps/web/vite.config.ts) forwards
# /api, /app, and /drafts to localhost:4111, so relative URLs work as-is.
#
# Production (Vercel): set in the Vercel dashboard under Environment Variables.
# Example: VITE_API_URL=https://wheel-of-time.onrender.com
VITE_API_URL=

# Supabase project URL — same value as the agent's SUPABASE_URL. Used by the
# browser-side supabase-js client for sign-in and session management.
VITE_SUPABASE_URL=https://<ref>.supabase.co

# Supabase publishable key — same value as the agent's SUPABASE_PUBLISHABLE_KEY.
# Safe to expose in the browser bundle; that's what it's designed for. (On
# older projects this is the "anon public" JWT — same role.)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
