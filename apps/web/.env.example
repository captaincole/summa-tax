# Origin of the Mastra API. Used at build time — apps/web/src/lib/apiBase.ts
# reads import.meta.env.VITE_API_URL and prefixes every fetch and <a href>
# that points at the backend.
#
# Local dev: leave unset. Vite's proxy (apps/web/vite.config.ts) forwards
# /api, /app, and /drafts to localhost:4111, so relative URLs work as-is.
#
# Production (Vercel): set in the Vercel dashboard under Environment Variables.
# Example: VITE_API_URL=https://wheel-of-time.onrender.com
VITE_API_URL=
