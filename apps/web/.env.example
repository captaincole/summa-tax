# Origin of the Mastra agent (chat streaming + the /app/* endpoints). Other
# data — activity, drafts, uploads, filings — is read from the local libsql
# app DB by Server Components / Route Handlers, so no proxy/rewrite is needed.
#
# Local dev: http://localhost:4111
NEXT_PUBLIC_AGENT_URL=http://localhost:4111

# Supabase AUTH (the only Supabase piece left — goes away in Phase 2 of the
# open-source transition). Same values as the agent's SUPABASE_URL /
# SUPABASE_PUBLISHABLE_KEY; both are safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local data files — must point at the SAME paths as the agent's env (the web
# server reads the app DB and document blobs directly; same box by design).
APP_DB_PATH=/absolute/path/to/apps/agent/.data/app.db
DOCUMENTS_PATH=/absolute/path/to/apps/agent/.data/documents
