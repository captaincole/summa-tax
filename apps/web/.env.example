# Origin of the Mastra agent (chat streaming + /app/session/reset). All other
# data — drafts, uploads, activity, header counters — is read directly from
# Supabase by Server Components, so no proxy/rewrite is needed.
#
# Local dev: http://localhost:4111
# Production: https://<your-agent-project>.vercel.app
NEXT_PUBLIC_AGENT_URL=http://localhost:4111

# Supabase project URL — same value as the agent's SUPABASE_URL. Used by both
# server- and client-side clients (cookie-based auth via @supabase/ssr).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co

# Supabase publishable key — same value as the agent's SUPABASE_PUBLISHABLE_KEY.
# Safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
