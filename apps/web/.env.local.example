# LOCAL Supabase config template for the web app.
#
# Setup:
#   1. Make sure the agent has its local .env.development first (see
#      apps/agent/.env.local.example).
#   2. `npm run db:start` (if not already running)
#   3. `npm run db:status` — copy the anon key
#   4. Copy this file to .env.development and paste the anon key in

# Agent stays on :4111 in local dev.
NEXT_PUBLIC_AGENT_URL=http://localhost:4111

# Local Supabase URL — must match SUPABASE_URL in apps/agent/.env.development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local anon (publishable) key from `supabase status` — must match
# SUPABASE_PUBLISHABLE_KEY in apps/agent/.env.development.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
