{
  "name": "project-wheel-of-time",
  "version": "0.1.0",
  "private": true,
  "description": "Wheel of Time — AI CPA platform for HNWI tax preparation. Agents are named after Wheel of Time characters; the front-desk conversational agent is Thom Merrilin.",
  "scripts": {
    "dev": "mastra dev --env .env.development",
    "dev:web": "npm --prefix web run dev",
    "dev:all": "concurrently -n mastra,web -c cyan,magenta \"npm:dev\" \"npm:dev:web\"",
    "build": "npm run build:web && mastra build --studio",
    "build:web": "npm --prefix web run build",
    "start": "cd .mastra/output && node index.mjs",
    "fixtures:build": "tsx fixtures/pipeline/render.ts",
    "db:reset": "tsx scripts/resetUserData.ts",
    "refdocs:ingest": "tsx scripts/ingestRefDoc.ts",
    "refdocs:verify": "tsx scripts/verifyRefDocs.ts",
    "smoke:review": "tsx scripts/smokeReview.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@libsql/client": "^0.15.15",
    "@mastra/core": "^1.25.0",
    "@mastra/libsql": "^1.8.1",
    "@mastra/loggers": "^1.1.1",
    "@mastra/memory": "^1.15.1",
    "@mastra/observability": "^1.9.1",
    "dotenv": "^17.4.2",
    "mastra": "^1.6.0",
    "tsx": "^4.20.5",
    "unpdf": "^1.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "concurrently": "^9.2.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^5"
  }
}
