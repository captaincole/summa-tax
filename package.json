{
  "name": "summa",
  "version": "0.1.0",
  "private": true,
  "description": "Summa monorepo. apps/agent is the Mastra-based AI CPA backend; apps/web is the React frontend. Each app installs and deploys independently.",
  "scripts": {
    "dev": "npm --prefix apps/agent run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:all": "concurrently -k -n agent,web -c cyan,magenta \"npm:dev\" \"npm:dev:web\"",
    "reset": "npm --prefix apps/agent run reset:data",
    "corpus:fetch": "npm --prefix apps/agent run corpus:fetch",
    "bootstrap": "node scripts/bootstrap-env.mjs",
    "predev": "node scripts/bootstrap-env.mjs",
    "predev:web": "node scripts/bootstrap-env.mjs",
    "predev:all": "node scripts/bootstrap-env.mjs",
    "build": "npm --prefix apps/agent run build",
    "build:web": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/agent run start",
    "refdocs:ingest": "npm --prefix apps/agent run refdocs:ingest",
    "refdocs:status": "npm --prefix apps/agent run refdocs:status",
    "refdocs:sync": "npm --prefix apps/agent run refdocs:sync",
    "refdocs:reembed": "npm --prefix apps/agent run refdocs:reembed",
    "forms:ingest": "npm --prefix apps/agent run forms:ingest --",
    "forms:bind": "npm --prefix apps/agent run forms:bind --",
    "forms:ingest-ca-tax-table": "npm --prefix apps/agent run forms:ingest-ca-tax-table --",
    "smoke:review": "npm --prefix apps/agent run smoke:review",
    "test": "npm --prefix apps/agent test",
    "test:alex": "npm --prefix apps/agent run test:alex",
    "test:catalog-fill": "npm --prefix apps/agent run test:catalog-fill --",
    "install:all": "npm install && npm --prefix apps/agent install && npm --prefix apps/web install",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7"
  }
}
